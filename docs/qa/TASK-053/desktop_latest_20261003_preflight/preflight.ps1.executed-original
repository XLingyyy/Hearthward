$before = [pscustomobject]@{
    install=$install; backup=$backup; player_root=$playerRoot; old_version=$oldBuild.version; new_version='0.2.0-preview.20261003.2';
    program=$beforeProgram; player=$beforePlayer; root_files=$rootFiles; shortcuts=$shortcuts; player_backup_matches=$true; running_processes=$running
}
Write-Json (Join-Path $evidence 'before.json') $before
Write-Json (Join-Path $backup 'before.json') $before
Write-Output ('Preflight complete: {0} program files fingerprinted; {1} player/config files backed up; existing game remains installed.' -f $beforeProgram.Count,$beforePlayer.Count)
