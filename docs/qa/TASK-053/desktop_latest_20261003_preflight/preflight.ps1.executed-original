}
foreach ($entry in $rootFiles) {
    Copy-Item -LiteralPath (Join-Path $gameRoot $entry.path) -Destination (Join-Path $rootBackup $entry.path)
}
$backupPlayer = @(Get-PlayerManifest $playerBackup)
